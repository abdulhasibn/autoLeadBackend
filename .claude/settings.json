{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify *)",
      "Bash(supabase db push *)",
      "Bash(supabase migration repair *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard/guard.mjs\" claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard/guard.mjs\" claude",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*__(apply_migration|execute_sql|deploy_edge_function|create_edge_function_secret|pause_project|restore_project|reset_branch|merge_branch|delete_branch)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard/guard.mjs\" claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
