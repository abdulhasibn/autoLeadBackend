// AutoLead schema — source of truth for migrations.
// Design tables here before writing supabase/migrations/*.sql.
//
// Conventions:
// - Soft delete via deleted_at timestamptz NULL (ADR-0005)
// - Audit fields (created_at, updated_at) on mutable entities
// - Foreign keys and indexes on status/date/filter columns
// - Command/query repository segregation per ADR-0001
// - Partial unique indexes WHERE deleted_at IS NULL for soft-deletable uniques
// - UUIDs via gen_random_uuid(); public.users.id mirrors auth.users.id
//
// Decision log (locked): multi-role via user_roles; one owner per vehicle;
// normalized make/model/variant catalog; vehicle_financials 1:1; contacts for
// anonymous leads; single expenses table; vehicle_status_history; showrooms table.

// ---------------------------------------------------------------------------
// Identity & Auth
// ---------------------------------------------------------------------------

Table showrooms {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  address text [not null]
  city text [not null]
  phone text [not null]
  opening_hours jsonb
  google_maps_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null, unique, note: 'admin | salesperson | owner | buyer']
  description text
}

Table users {
  id uuid [pk, note: 'mirrors auth.users.id']
  full_name text [not null]
  phone text
  email text
  avatar_url text
  showroom_id uuid [ref: > showrooms.id, note: 'nullable for buyers/owners']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (phone) [unique, name: 'users_phone_active_uidx', note: 'WHERE deleted_at IS NULL AND phone IS NOT NULL']
    (email) [unique, name: 'users_email_active_uidx', note: 'WHERE deleted_at IS NULL AND email IS NOT NULL']
    (showroom_id) [name: 'users_showroom_id_idx']
  }
}

Table user_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  granted_by uuid [ref: > users.id]
  granted_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (user_id, role_id) [unique, name: 'user_roles_user_role_active_uidx', note: 'WHERE deleted_at IS NULL']
    (user_id) [name: 'user_roles_user_id_idx']
  }
}

// ---------------------------------------------------------------------------
// Vehicle catalog
// ---------------------------------------------------------------------------

Table makes {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  deleted_at timestamptz

  indexes {
    (name) [unique, name: 'makes_name_active_uidx', note: 'WHERE deleted_at IS NULL']
  }
}

Table models {
  id uuid [pk, default: `gen_random_uuid()`]
  make_id uuid [not null, ref: > makes.id]
  name text [not null]
  deleted_at timestamptz

  indexes {
    (make_id, name) [unique, name: 'models_make_name_active_uidx', note: 'WHERE deleted_at IS NULL']
  }
}

Table variants {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [not null, ref: > models.id]
  name text [not null]
  ex_showroom_price numeric(14,2) [note: 'new-car ex-showroom reference; not the used-vehicle price']
  displacement_cc integer
  cylinders smallint
  fuel_tank_capacity_l numeric(6,1)
  fuel_type text [note: 'petrol | diesel | cng | electric | hybrid | cng_petrol']
  height_mm integer
  length_mm integer
  width_mm integer
  body_type text
  seating_capacity smallint
  transmission text [note: 'manual | automatic | amt | cvt | dct']
  power numeric(8,2) [note: 'source Power; mostly bhp']
  torque numeric(8,2) [note: 'source Torque; mostly Nm']
  deleted_at timestamptz

  indexes {
    (model_id, name) [unique, name: 'variants_model_name_active_uidx', note: 'WHERE deleted_at IS NULL']
  }
}

// ---------------------------------------------------------------------------
// Owners
// ---------------------------------------------------------------------------

Table owners {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: - users.id, note: 'nullable until owner creates an account']
  full_name text [not null]
  phone text [not null]
  email text
  address text
  city text
  preferred_contact_method text [note: 'phone | email | whatsapp']
  alt_phone text
  id_info text [note: 'sensitive; encrypt or vault before production']
  notes text
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (phone) [unique, name: 'owners_phone_active_uidx', note: 'WHERE deleted_at IS NULL']
    (user_id) [unique, name: 'owners_user_id_uidx', note: 'WHERE user_id IS NOT NULL']
  }
}

// ---------------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------------

Table vehicles {
  id uuid [pk, default: `gen_random_uuid()`]
  showroom_id uuid [not null, ref: > showrooms.id]
  owner_id uuid [not null, ref: > owners.id]
  variant_id uuid [not null, ref: > variants.id]
  year smallint [not null]
  registration_number text [not null]
  fuel_type text [not null, note: 'petrol | diesel | cng | electric | hybrid']
  transmission text [not null, note: 'manual | automatic | amt | cvt | dct']
  km_driven integer [not null]
  num_previous_owners smallint [not null, default: 0]
  colour text [not null]
  insurance_valid_until date
  rc_status text [note: 'clear | hypothecation | under_transfer']
  service_history text [note: 'full | partial | none | unknown']
  accident_history boolean [not null, default: false]
  loan_status text [note: 'clear | active']
  location text
  description text
  status text [not null, default: 'submitted', note: 'submitted | inspection_pending | under_inspection | approved | available | reserved | sold | rejected | on_hold | removed']
  acquisition_type text [not null, note: 'dealership_purchase | consignment | intermediary_sale']
  submitted_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (registration_number) [unique, name: 'vehicles_registration_active_uidx', note: 'WHERE deleted_at IS NULL']
    (showroom_id, status) [name: 'vehicles_showroom_status_idx']
    (owner_id) [name: 'vehicles_owner_id_idx']
    (status, created_at) [name: 'vehicles_status_created_at_idx']
  }
}

Table vehicle_financials {
  id uuid [pk, default: `gen_random_uuid()`]
  vehicle_id uuid [not null, unique, ref: - vehicles.id]
  owner_expected_price numeric(12,2)
  company_purchase_price numeric(12,2)
  expected_selling_price numeric(12,2)
  minimum_selling_price numeric(12,2)
  listed_price numeric(12,2)
  commission_amount numeric(12,2)
  commission_percent numeric(5,2)
  other_costs numeric(12,2)
  actual_selling_price numeric(12,2)
  sold_at timestamptz
  sold_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table vehicle_media {
  id uuid [pk, default: `gen_random_uuid()`]
  vehicle_id uuid [not null, ref: > vehicles.id]
  storage_path text [not null]
  category text [note: 'front | rear | left | right | interior | dashboard | engine | tyres | other']
  sort_order smallint [not null, default: 0]
  uploaded_by uuid [not null, ref: > users.id]
  uploaded_at timestamptz [not null, default: `now()`]

  indexes {
    (vehicle_id, sort_order) [name: 'vehicle_media_vehicle_sort_idx']
    (storage_path) [unique, name: 'vehicle_media_storage_path_uidx']
  }
}

Table vehicle_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  vehicle_id uuid [not null, ref: > vehicles.id]
  doc_type text [note: 'rc | insurance | service_record | loan_clearance | inspection_report | other']
  storage_path text [not null]
  is_sensitive boolean [not null, default: true]
  uploaded_by uuid [not null, ref: > users.id]
  uploaded_at timestamptz [not null, default: `now()`]

  indexes {
    (vehicle_id, doc_type) [name: 'vehicle_documents_vehicle_type_idx']
    (storage_path) [unique, name: 'vehicle_documents_storage_path_uidx']
  }
}

Table vehicle_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  vehicle_id uuid [not null, ref: > vehicles.id]
  from_status text
  to_status text [not null]
  changed_by uuid [not null, ref: > users.id]
  reason text
  changed_at timestamptz [not null, default: `now()`]

  Note: 'Append-only; no soft delete'

  indexes {
    (vehicle_id, changed_at) [name: 'vehicle_status_history_vehicle_changed_idx']
  }
}

// ---------------------------------------------------------------------------
// Buyers
// ---------------------------------------------------------------------------

Table buyers {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique, ref: - users.id]
  budget_min numeric(12,2)
  budget_max numeric(12,2)
  preferred_contact_method text [note: 'phone | email | whatsapp']
  location text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table buyer_preferences {
  id uuid [pk, default: `gen_random_uuid()`]
  buyer_id uuid [not null, ref: > buyers.id]
  preference_type text [not null, note: 'fuel_type | transmission | make']
  value text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id) [name: 'buyer_preferences_buyer_id_idx']
  }
}

Table saved_vehicles {
  id uuid [pk, default: `gen_random_uuid()`]
  buyer_id uuid [not null, ref: > buyers.id]
  vehicle_id uuid [not null, ref: > vehicles.id]
  saved_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, vehicle_id) [unique, name: 'saved_vehicles_buyer_vehicle_uidx']
  }
}

Table recently_viewed {
  id uuid [pk, default: `gen_random_uuid()`]
  buyer_id uuid [not null, ref: > buyers.id]
  vehicle_id uuid [not null, ref: > vehicles.id]
  viewed_at timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, viewed_at) [name: 'recently_viewed_buyer_viewed_idx']
  }
}

// ---------------------------------------------------------------------------
// Contacts (anonymous / walk-in)
// ---------------------------------------------------------------------------

Table contacts {
  id uuid [pk, default: `gen_random_uuid()`]
  full_name text [not null]
  phone text [not null]
  email text
  merged_into_user_id uuid [ref: > users.id]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (phone) [unique, name: 'contacts_phone_active_unmerged_uidx', note: 'WHERE deleted_at IS NULL AND merged_into_user_id IS NULL']
  }
}

// ---------------------------------------------------------------------------
// Leads & follow-ups
// ---------------------------------------------------------------------------

Table leads {
  id uuid [pk, default: `gen_random_uuid()`]
  showroom_id uuid [not null, ref: > showrooms.id]
  vehicle_id uuid [ref: > vehicles.id]
  user_id uuid [ref: > users.id, note: 'registered buyer; XOR with contact_id']
  contact_id uuid [ref: > contacts.id, note: 'walk-in; XOR with user_id']
  assigned_to uuid [ref: > users.id]
  source text [not null, note: 'marketplace | mobile_app | website | phone | walkin | whatsapp | instagram | facebook | referral | other']
  status text [not null, default: 'new', note: 'new | contacted | interested | follow_up | test_drive | negotiation | booking_confirmed | sold | lost | not_interested | no_response']
  budget numeric(12,2)
  preferred_vehicle text
  purchase_timeline text
  finance_required boolean
  current_vehicle text
  trade_in_required boolean
  notes text
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'CHECK: exactly one of user_id or contact_id is set'

  indexes {
    (showroom_id, status, created_at) [name: 'leads_showroom_status_created_idx']
    (assigned_to, status) [name: 'leads_assigned_status_idx']
    (vehicle_id) [name: 'leads_vehicle_id_idx']
  }
}

Table lead_status_history {
  id uuid [pk, default: `gen_random_uuid()`]
  lead_id uuid [not null, ref: > leads.id]
  from_status text
  to_status text [not null]
  changed_by uuid [not null, ref: > users.id]
  notes text
  changed_at timestamptz [not null, default: `now()`]

  Note: 'Append-only; no soft delete'

  indexes {
    (lead_id, changed_at) [name: 'lead_status_history_lead_changed_idx']
  }
}

Table follow_ups {
  id uuid [pk, default: `gen_random_uuid()`]
  lead_id uuid [not null, ref: > leads.id]
  assigned_to uuid [not null, ref: > users.id]
  task_type text [not null, note: 'call | whatsapp | meeting | test_drive | send_quotation | other']
  scheduled_at timestamptz [not null]
  completed_at timestamptz
  notes text
  outcome text
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (assigned_to, scheduled_at, completed_at) [name: 'follow_ups_assigned_schedule_idx']
    (lead_id) [name: 'follow_ups_lead_id_idx']
  }
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

Table expenses {
  id uuid [pk, default: `gen_random_uuid()`]
  showroom_id uuid [not null, ref: > showrooms.id]
  type text [not null, note: 'vehicle | business']
  vehicle_id uuid [ref: > vehicles.id]
  category text [not null]
  amount numeric(12,2) [not null]
  description text
  incurred_on date [not null]
  recorded_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: 'CHECK: vehicle type requires vehicle_id; business type requires vehicle_id IS NULL'

  indexes {
    (showroom_id, type, incurred_on) [name: 'expenses_showroom_type_date_idx']
    (vehicle_id) [name: 'expenses_vehicle_id_idx']
  }
}

Table income {
  id uuid [pk, default: `gen_random_uuid()`]
  showroom_id uuid [not null, ref: > showrooms.id]
  category text [not null, note: 'vehicle_sale | commission | finance_commission | insurance_commission | other']
  vehicle_id uuid [ref: > vehicles.id]
  amount numeric(12,2) [not null]
  description text
  received_on date [not null]
  recorded_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (showroom_id, category, received_on) [name: 'income_showroom_category_date_idx']
  }
}

// ---------------------------------------------------------------------------
// Audit & notifications
// ---------------------------------------------------------------------------

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  entity_type text [not null]
  entity_id uuid [not null]
  action text [not null]
  actor_id uuid [ref: > users.id]
  before_value jsonb
  after_value jsonb
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  Note: 'Append-only; never soft-deleted'

  indexes {
    (entity_type, entity_id, created_at) [name: 'audit_logs_entity_created_idx']
    (actor_id, created_at) [name: 'audit_logs_actor_created_idx']
  }
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  type text [not null]
  title text [not null]
  body text
  entity_type text
  entity_id uuid
  is_read boolean [not null, default: false]
  due_at timestamptz [note: 'null means visible immediately; follow_up_due uses scheduled time']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_read, created_at) [name: 'notifications_user_unread_idx']
    (user_id, due_at) [name: 'notifications_user_due_idx']
  }
}
