# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase (infrastructure/ only — never read outside src/infrastructure and src/config)
SUPABASE_URL=https://pptljtbxqzmjossuamve.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Required only for HS256 (local Docker). Hosted projects that sign
# with ES256 verify via JWKS (`getClaims`) and do not need this.
# SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-characters
