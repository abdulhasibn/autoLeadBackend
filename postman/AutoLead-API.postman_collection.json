              "mode": "raw",
              "raw": "{\n  \"year\": 2019,\n  \"registrationNumber\": \"KA01AB1234\",\n  \"fuelType\": \"petrol\",\n  \"transmission\": \"manual\",\n  \"kmDriven\": 43000,\n  \"numPreviousOwners\": 1,\n  \"colour\": \"White\",\n  \"insuranceValidUntil\": null,\n  \"rcStatus\": \"clear\",\n  \"serviceHistory\": \"full\",\n  \"accidentHistory\": false,\n  \"loanStatus\": \"clear\",\n  \"location\": \"Bengaluru\",\n  \"description\": \"updated\"\n}",
