                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": {\n    \"code\": \"AUTHENTICATION_REQUIRED\",\n    \"message\": \"Authentication required\"\n  }\n}"
            },
            {
              "id": "ebc92884-8227-4a1a-b5e2-985a3647bfd3",
              "name": "503 DB Unavailable",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/auth/me"
              },
              "status": "Service Unavailable",
              "code": 503,
